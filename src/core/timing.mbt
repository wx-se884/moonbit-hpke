///|
/// Constant-time comparison of two byte sequences to mitigate timing side-channel attacks.
pub fn constant_time_compare(a : Bytes, b : Bytes) -> Bool {
  if a.length() != b.length() {
    return false
  }
  let mut diff = 0
  for i in 0..<a.length() {
    diff = diff | (a[i].to_int() ^ b[i].to_int())
  }
  diff == 0
}

///|
/// Securely overwrites the mutable byte buffer with zeros to clear sensitive material from memory.
pub fn zeroize_fixed(b : FixedArray[Byte]) -> Unit {
  for i in 0..<b.length() {
    b[i] = b'\x00'
  }
}
